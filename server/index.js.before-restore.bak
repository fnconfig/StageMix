const path = require("path");
const fs = require("fs");
const os = require("os");
const crypto = require("crypto");
const express = require("express");
const { WebSocketServer } = require("ws");

const store = require("./store");
const { RcpClient } = require("./rcpClient");
const { MockRcpClient } = require("./mockRcpClient");

const PORT = process.env.PORT || 3000;

const app = express();

// HTTP request logging (method path status duration — no tokens/body)
app.use((req, res, next) => {
  const start = Date.now();
  res.on("finish", () => {
    console.log(`HTTP ${req.method} ${req.path} ${res.statusCode} ${Date.now() - start}ms`);
  });
  next();
});

// Larger body limit so the admin can upload the landing cover as base64.
app.use(express.json({ limit: "12mb" }));
app.use(express.static(path.join(__dirname, "..", "public"), {
  etag: false,
  lastModified: false,
  setHeaders: (res) => res.setHeader("Cache-Control", "no-store"),
}));

let db = store.load();
let mixerStatus = { connected: false };
let rcp = null;

// ---- landing cover ----
// The admin can replace the landing page background with their own photo. It is
// stored as data/cover.jpg (outside public/, so it isn't served as a static
// asset) and exposed through a small route. `db.landing.cover` holds either
// null (use the bundled default) or the mtime of the custom file, used to bust
// the browser cache so a re-upload shows up immediately.
const COVER_PATH = path.join(__dirname, "..", "data", "cover.jpg");

function coverUrl() {
  try {
    const stat = fs.statSync(COVER_PATH);
    return `/cover?v=${stat.mtimeMs}`;
  } catch (e) {
    return "/cover-default.jpg"; // bundled default (public/)
  }
}

// Strip a browser data-URL prefix to raw bytes; returns { buf, mime } or null.
function decodeDataUrl(dataUrl) {
  if (typeof dataUrl !== "string") return null;
  const m = /^data:([^;]+);base64,(.+)$/s.exec(dataUrl.trim());
  if (!m) return null;
  return { mime: m[1], buf: Buffer.from(m[2], "base64") };
}

// Sniff the content type from magic bytes so the /cover route returns the
// correct header regardless of the file extension (the upload is stored as
// data/cover.jpg but could actually be a PNG/WebP/GIF).
function sniffMime(buf) {
  if (!buf || buf.length < 4) return "application/octet-stream";
  if (buf[0] === 0xff && buf[1] === 0xd8) return "image/jpeg";
  if (buf[0] === 0x89 && buf[1] === 0x50 && buf[2] === 0x4e && buf[3] === 0x47) return "image/png";
  if (buf[0] === 0x52 && buf[1] === 0x49 && buf[2] === 0x46 && buf[3] === 0x46) return "image/webp";
  if (buf[0] === 0x47 && buf[1] === 0x49 && buf[2] === 0x46) return "image/gif";
  return "application/octet-stream";
}

// ---- websocket broadcast plumbing ----
let wss = null;
function broadcast(msg) {
  if (!wss) return;
  const data = JSON.stringify(msg);
  wss.clients.forEach((client) => {
    if (client.readyState === 1) client.send(data);
  });
}

// Send a message only to sockets that have subscribed to a specific aux mix.
// Kept separate from broadcast() so the existing global messages (mixerStatus,
// notify, mixesChanged, sessionsChanged, ...) keep their current behavior.
// Sockets opt in by sending { type: "subscribe", mixId } after opening /ws.
function broadcastToMix(msg, mixId) {
  if (!wss) return;
  const data = JSON.stringify(msg);
  wss.clients.forEach((client) => {
    if (client.readyState === 1 && client.mixId === mixId) client.send(data);
  });
}

function startMixerClient() {
  if (rcp) {
    // Remove all listeners BEFORE stop() so that the old socket's async
    // 'close' event cannot fire its 'status' handler and overwrite mixerStatus
    // with { connected: false } after the new client has already connected.
    rcp.removeAllListeners();
    rcp.stop();
  }
  mixerStatus = { connected: false, host: db.mixer.host, port: db.mixer.port };
  broadcast({ type: "mixerStatus", status: mixerStatus });
  const opts = { host: db.mixer.host, port: db.mixer.port };
  rcp = db.mixer.mode === "real" ? new RcpClient(opts) : new MockRcpClient(opts);
  rcp.on("status", (s) => {
    mixerStatus = s;
    broadcast({ type: "mixerStatus", status: mixerStatus });
  });
  rcp.on("notify", (line) => {
    broadcast({ type: "notify", line });
  });
  rcp.start();
}

// ---- helpers ----
function adminUser(req, res, next) {
  const token = req.headers["x-admin-token"];
  const username = token ? db._adminTokens[token] : null;
  if (!username) {
    return res.status(401).json({ error: "Admin authentication required" });
  }
  const user = db.admin.users.find((u) => u.username === username);
  if (!user) {
    // account was removed while signed in — session is dead
    delete db._adminTokens[token];
    return res.status(401).json({ error: "Admin authentication required" });
  }
  req.adminUser = user;
  next();
}
// `requireAdmin` is the name used by every existing admin route. Renaming the
// function body (adminUser) would touch dozens of routes, so keep the alias.
const requireAdmin = adminUser;

function findChannel(id) {
  return db.channels.find((c) => c.id === id) || db.returns.find((c) => c.id === id);
}
function findMix(id) {
  return db.mixes.find((m) => m.id === id);
}
function findAdminUser(username) {
  if (!username) return null;
  const uname = String(username).toLowerCase();
  return db.admin.users.find((u) => u.username.toLowerCase() === uname) || null;
}

// A channel may be a mono input (InCh) or a stereo return (FxRtnCh). The
// `kind` selects the RCP path; `index` is the channel index on that element.
// mix.channelIds is the source of truth for which channels appear AND their
// display order on the user page.
function channelsForMix(mix) {
  return mix.channelIds
    .map((id) => findChannel(id))
    .filter(Boolean);
}

// Snapshot of one aux mix's channel assignment, pushed to viewers in real time
// whenever the admin changes which channels are in the mix.
function mixConfigMessage(mix) {
  return {
    type: "mixConfigUpdated",
    mixId: mix.id,
    name: mix.name,
    visible: mix.visible,
    channels: channelsForMix(mix).map((c) => ({ id: c.id, name: c.name, index: c.index })),
  };
}

function sanitizeSessions() {
  const out = {};
  for (const [key, s] of Object.entries(db.sessions)) {
    out[key] = {
      name: s.name,
      mixId: s.mixId,
      joinedAt: s.joinedAt || s.lastSeen || null, // fallback: old sessions pre-date joinedAt
      lastSeen: s.lastSeen,
    };
  }
  return out;
}

// =========================================================================
// Public / normal-user API (no login, matches "Normal User" branch)
// =========================================================================

// health check — no auth, read-only, never touches the mixer
app.get("/health", (req, res) => {
  res.json({ status: "ok", uptime: process.uptime(), mixer: mixerStatus });
});

// landing cover — public, read-only. Returns the URL for the active cover photo.
app.get("/api/landing", (req, res) => {
  res.json({ coverUrl: coverUrl() });
});

// The cover file itself (streamed, so it isn't in public/). No auth — band
// members need to see it on the landing screen before they log in.
app.get("/cover", (req, res) => {
  try {
    const stat = fs.statSync(COVER_PATH);
    // Read the header bytes to set the correct content type for the actual image.
    const head = Buffer.alloc(12);
    const fd = fs.openSync(COVER_PATH, "r");
    fs.readSync(fd, head, 0, 12, 0);
    fs.closeSync(fd);
    res.setHeader("Content-Type", sniffMime(head));
    res.setHeader("Cache-Control", "no-store");
    res.setHeader("Content-Length", stat.size);
    fs.createReadStream(COVER_PATH).pipe(res);
  } catch (e) {
    res.status(404).json({ error: "No custom cover uploaded" });
  }
});

// list of aux mixes currently visible to normal users
app.get("/api/mixes", (req, res) => {
  const visible = db.mixes
    .filter((m) => m.visible)
    .map((m) => ({ id: m.id, name: m.name }));
  res.json({ mixes: visible, mixerConnected: !!mixerStatus.connected });
});

// "Masukan Nama" + "Select Aux Channel" step: create/refresh a named session
app.post("/api/session", (req, res) => {
  const { name, mixId } = req.body || {};
  if (!name || !name.trim()) return res.status(400).json({ error: "Name is required" });
  const mix = findMix(mixId);
  if (!mix || !mix.visible) return res.status(400).json({ error: "That aux mix isn't available" });

  const key = name.trim().toLowerCase();
  const token = crypto.randomUUID();
  db.sessions[key] = {
    name: name.trim(),
    mixId: mix.id,
    token,
    joinedAt: Date.now(), // when this user logged in (for the Active Users list)
    lastSeen: Date.now(),
    removed: false,
  };
  store.save(db);
  broadcast({ type: "sessionsChanged" });
  res.json({ token, name: name.trim(), mix: { id: mix.id, name: mix.name } });
});

function sessionFromToken(token) {
  return Object.values(db.sessions).find((s) => s.token === token);
}

// middleware for normal-user endpoints: validates the session token
function requireSession(req, res, next) {
  const token = req.headers["x-session-token"];
  const session = token && sessionFromToken(token);
  if (!session) return res.status(401).json({ error: "Session not found, please rejoin" });
  if (session.removed) return res.status(410).json({ error: "removed" });
  session.lastSeen = Date.now();
  req.session = session;
  next();
}

app.get("/api/session/check", requireSession, (req, res) => {
  const mix = findMix(req.session.mixId);
  res.json({ ok: true, name: req.session.name, mix: mix ? { id: mix.id, name: mix.name } : null });
});

// "Control Send on Fader Channel Volume" step: list channels + current levels
app.get("/api/channels", requireSession, async (req, res) => {
  const mix = findMix(req.session.mixId);
  if (!mix) return res.status(400).json({ error: "Assigned mix no longer exists" });
  const channels = channelsForMix(mix);

  // The TF RCP protocol is strictly serial — no correlation IDs, so responses
  // are matched to requests by FIFO position on a single TCP connection.
  // Firing all requests in parallel races them onto the socket simultaneously
  // which is fine for queuing, but a single timeout anywhere mid-queue calls
  // socket.destroy() and drops the whole connection, rejecting every subsequent
  // channel. Fetching sequentially (level then mute per channel) keeps the
  // queue short and isolates failures to individual channels only.
  const results = [];
  for (const ch of channels) {
    let level = -60;
    let on = true;
    const kind = ch.kind || "in";
    try {
      const raw = await rcp.getToMixLevel(kind, ch.index, mix.index);
      // JSON.stringify converts -Infinity → null (JSON has no Infinity literal).
      // Clamp to faderMinDb so the browser always receives a finite number.
      level = isFinite(raw) ? raw : db.mixer.faderMinDb;
    } catch (e) {
      /* leave default if mixer unreachable */
    }
    try {
      on = await rcp.getToMixOn(kind, ch.index, mix.index);
    } catch (e) {
      /* leave default (unmuted) if mixer unreachable */
    }
    results.push({ id: ch.id, name: ch.name, kind, index: ch.index, level, on });
  }
  // Also fetch the mix's own master fader level and on/off (mute) state
  let masterLevel = 0; // 0 dB = unity
  let masterOn = true; // console's "On" == unmuted
  try {
    const raw = await rcp.getMixLevel(mix.index);
    masterLevel = isFinite(raw) ? raw : db.mixer.faderMinDb;
  } catch (e) { /* leave 0 dB if unreachable */ }
  try {
    masterOn = await rcp.getMixOn(mix.index);
  } catch (e) { /* leave unmuted if unreachable */ }

  // DCA group faders — separate control (not sent to a mix). Each member can
  // move a DCA fader; it scales that group on the main mix.
  const dca = [];
  for (const d of db.dca) {
    let level = 0;
    let on = true;
    try {
      const raw = await rcp.getDcaLevel(d.index);
      level = isFinite(raw) ? raw : 0;
    } catch (e) { /* leave 0 dB if unreachable */ }
    try {
      on = await rcp.getDcaOn(d.index);
    } catch (e) { /* leave on if unreachable */ }
    dca.push({ id: d.id, name: d.name, index: d.index, level, on });
  }

  res.json({ mix: { id: mix.id, name: mix.name, index: mix.index, masterLevel, masterOn }, channels: results, dca, mixerConnected: !!mixerStatus.connected });
});

app.post("/api/fader", requireSession, async (req, res) => {
  const { channelId, level } = req.body || {};
  const mix = findMix(req.session.mixId);
  const channel = findChannel(channelId);
  if (!mix || !channel) return res.status(400).json({ error: "Unknown channel or mix" });
  if (!mix.channelIds.includes(channel.id)) return res.status(403).json({ error: "Channel not available in your mix" });
  const clamped = Math.max(db.mixer.faderMinDb, Math.min(db.mixer.faderMaxDb, Number(level)));
  try {
    await rcp.setToMixLevel(channel.kind || "in", channel.index, mix.index, clamped);
    // Live-mirror the change to every other user viewing this same aux mix.
    broadcastToMix({ type: "mixLevelUpdated", mixId: mix.id, channelId: channel.id, level: clamped }, mix.id);
    res.json({ ok: true, level: clamped });
  } catch (e) {
    res.status(502).json({ error: "Could not reach mixer: " + e.message });
  }
});

// mute/unmute a channel's send to the user's own mix
app.post("/api/mute", requireSession, async (req, res) => {
  const { channelId, muted } = req.body || {};
  const mix = findMix(req.session.mixId);
  const channel = findChannel(channelId);
  if (!mix || !channel) return res.status(400).json({ error: "Unknown channel or mix" });
  if (!mix.channelIds.includes(channel.id)) return res.status(403).json({ error: "Channel not available in your mix" });
  try {
    await rcp.setToMixOn(channel.kind || "in", channel.index, mix.index, !muted); // console's "On" == unmuted
    broadcastToMix({ type: "mixMuteUpdated", mixId: mix.id, channelId: channel.id, muted: !!muted }, mix.id);
    res.json({ ok: true, muted: !!muted });
  } catch (e) {
    res.status(502).json({ error: "Could not reach mixer: " + e.message });
  }
});

// move a DCA group fader of the user's own aux mix
app.post("/api/dca", requireSession, async (req, res) => {
  const { dcaId, level } = req.body || {};
  const dca = db.dca.find((d) => d.id === dcaId);
  if (!dca) return res.status(400).json({ error: "Unknown DCA" });
  const clamped = Math.max(db.mixer.faderMinDb, Math.min(db.mixer.faderMaxDb, Number(level)));
  try {
    await rcp.setDcaLevel(dca.index, clamped);
    broadcastToMix({ type: "dcaLevelUpdated", mixId: req.session.mixId, dcaId, level: clamped }, req.session.mixId);
    res.json({ ok: true, level: clamped });
  } catch (e) {
    res.status(502).json({ error: "Could not reach mixer: " + e.message });
  }
});

// mute/unmute a DCA group fader
app.post("/api/dca-mute", requireSession, async (req, res) => {
  const { dcaId, muted } = req.body || {};
  const dca = db.dca.find((d) => d.id === dcaId);
  if (!dca) return res.status(400).json({ error: "Unknown DCA" });
  try {
    await rcp.setDcaOn(dca.index, !muted);
    broadcastToMix({ type: "dcaMuteUpdated", mixId: req.session.mixId, dcaId, muted: !!muted }, req.session.mixId);
    res.json({ ok: true, muted: !!muted });
  } catch (e) {
    res.status(502).json({ error: "Could not reach mixer: " + e.message });
  }
});

// set the master fader level of the user's own aux mix
app.post("/api/mix-master", requireSession, async (req, res) => {
  const { level } = req.body || {};
  const mix = findMix(req.session.mixId);
  if (!mix) return res.status(400).json({ error: "Assigned mix no longer exists" });
  const clamped = Math.max(db.mixer.faderMinDb, Math.min(db.mixer.faderMaxDb, Number(level)));
  try {
    await rcp.setMixLevel(mix.index, clamped);
    broadcastToMix({ type: "mixMasterUpdated", mixId: mix.id, level: clamped }, mix.id);
    res.json({ ok: true, level: clamped });
  } catch (e) {
    res.status(502).json({ error: "Could not reach mixer: " + e.message });
  }
});

// mute/unmute the master fader of the user's own aux mix
app.post("/api/mix-master-mute", requireSession, async (req, res) => {
  const { muted } = req.body || {};
  const mix = findMix(req.session.mixId);
  if (!mix) return res.status(400).json({ error: "Assigned mix no longer exists" });
  try {
    await rcp.setMixOn(mix.index, !muted); // console's "On" == unmuted
    broadcastToMix({ type: "mixMasterMuteUpdated", mixId: mix.id, muted: !!muted }, mix.id);
    res.json({ ok: true, muted: !!muted });
  } catch (e) {
    res.status(502).json({ error: "Could not reach mixer: " + e.message });
  }
});

// =========================================================================
// Admin API (password protected, matches "Admiin" branch)
// =========================================================================

app.post("/api/admin/login", (req, res) => {
  const { username, password } = req.body || {};
  // Backward compatibility: old clients send only { password } — that signs in
  // as the built-in "admin" user.
  const uname = typeof username === "string" && username.trim() ? username.trim() : "admin";
  const user = findAdminUser(uname);
  if (!user || !password || !store.verifyPassword(password, user.passwordHash)) {
    return res.status(401).json({ error: "Wrong username or password" });
  }
  const token = crypto.randomUUID();
  db._adminTokens[token] = user.username;
  store.save(db);
  res.json({ token, username: user.username });
});

app.post("/api/admin/logout", requireAdmin, (req, res) => {
  const token = req.headers["x-admin-token"];
  if (token && db._adminTokens[token]) {
    delete db._adminTokens[token];
    store.save(db);
  }
  res.json({ ok: true });
});

// list admin accounts (usernames only — hashes never leave the server)
app.get("/api/admin/users", requireAdmin, (req, res) => {
  res.json({
    users: db.admin.users.map((u) => ({ username: u.username })),
    current: req.adminUser.username,
  });
});

// create a new admin account
app.post("/api/admin/users", requireAdmin, (req, res) => {
  const { username, password } = req.body || {};
  const uname = typeof username === "string" ? username.trim() : "";
  if (!uname || uname.length > 40) {
    return res.status(400).json({ error: "Username must be 1-40 characters" });
  }
  if (/[/\\]/.test(uname)) {
    return res.status(400).json({ error: "Username can't contain / or \\" });
  }
  if (findAdminUser(uname)) {
    return res.status(409).json({ error: "That username is already taken" });
  }
  if (!password || String(password).length < 4) {
    return res.status(400).json({ error: "Password must be at least 4 characters" });
  }
  db.admin.users.push({ username: uname, passwordHash: store.hashPassword(String(password)) });
  store.save(db);
  res.json({ ok: true, user: { username: uname } });
});

// change any user's password
app.post("/api/admin/users/:username/password", requireAdmin, (req, res) => {
  const user = findAdminUser(req.params.username);
  if (!user) return res.status(404).json({ error: "User not found" });
  const { password } = req.body || {};
  if (!password || String(password).length < 4) {
    return res.status(400).json({ error: "Password must be at least 4 characters" });
  }
  user.passwordHash = store.hashPassword(String(password));
  store.save(db);
  res.json({ ok: true });
});

// remove an admin account. The built-in "admin" user and the account you're
// currently signed in with can't be removed (prevents lockout).
app.post("/api/admin/users/:username/remove", requireAdmin, (req, res) => {
  const user = findAdminUser(req.params.username);
  if (!user) return res.status(404).json({ error: "User not found" });
  if (user.username === "admin") {
    return res.status(400).json({ error: "The built-in admin account can't be removed" });
  }
  if (user.username === req.adminUser.username) {
    return res.status(400).json({ error: "You can't remove the account you're signed in with" });
  }
  db.admin.users = db.admin.users.filter((u) => u !== user);
  // kill any live sessions of the removed user
  for (const [token, uname] of Object.entries(db._adminTokens)) {
    if (uname === user.username) delete db._adminTokens[token];
  }
  store.save(db);
  res.json({ ok: true });
});

// legacy single-admin password change — still supported, maps to the built-in
// "admin" account so old clients don't break.
app.post("/api/admin/password", requireAdmin, (req, res) => {
  const { newPassword } = req.body || {};
  if (!newPassword || newPassword.length < 4) {
    return res.status(400).json({ error: "Password must be at least 4 characters" });
  }
  const adminUser = findAdminUser("admin");
  adminUser.passwordHash = store.hashPassword(newPassword);
  store.save(db);
  res.json({ ok: true });
});

app.get("/api/admin/network-info", requireAdmin, (req, res) => {
  const addresses = [];
  const ifaces = os.networkInterfaces();
  for (const name of Object.keys(ifaces)) {
    for (const iface of ifaces[name] || []) {
      if (iface.family === "IPv4" && !iface.internal) {
        addresses.push(iface.address);
      }
    }
  }
  res.json({ addresses, port: PORT });
});

app.get("/api/admin/config", requireAdmin, (req, res) => {
  res.json({
    mixer: db.mixer,
    mixerStatus,
    channels: db.channels,
    returns: db.returns,
    dca: db.dca,
    mixes: db.mixes,
    sessions: sanitizeSessions(),
    users: db.admin.users.map((u) => ({ username: u.username })),
    currentUser: req.adminUser.username,
    coverUrl: coverUrl(),
  });
});

// upload a custom landing cover photo (base64 data URL). Saved to data/cover.jpg.
app.post("/api/admin/cover", requireAdmin, (req, res) => {
  const { dataUrl } = req.body || {};
  const decoded = decodeDataUrl(dataUrl);
  if (!decoded || !decoded.buf.length) {
    return res.status(400).json({ error: "Expected a base64 image data URL" });
  }
  const ALLOWED = new Set(["image/jpeg", "image/png", "image/webp", "image/gif"]);
  if (!ALLOWED.has(decoded.mime)) {
    return res.status(400).json({ error: "Only PNG, JPEG, WebP or GIF images are allowed" });
  }
  if (decoded.buf.length > 8 * 1024 * 1024) {
    return res.status(400).json({ error: "Image is too large (8 MB max)" });
  }
  try {
    fs.writeFileSync(COVER_PATH, decoded.buf);
    res.json({ ok: true, coverUrl: coverUrl() });
  } catch (e) {
    res.status(500).json({ error: "Could not save cover: " + e.message });
  }
});

// revert the landing cover to the bundled default photo
app.post("/api/admin/cover/reset", requireAdmin, (req, res) => {
  try {
    fs.unlinkSync(COVER_PATH);
  } catch (e) { /* nothing custom to remove */ }
  res.json({ ok: true, coverUrl: coverUrl() });
});

app.post("/api/admin/mixer", requireAdmin, (req, res) => {
  const { host, port, mode, faderMinDb, faderMaxDb } = req.body || {};
  if (host !== undefined) db.mixer.host = host;
  if (port !== undefined) db.mixer.port = Number(port);
  if (mode !== undefined) db.mixer.mode = mode === "real" ? "real" : "mock";
  if (faderMinDb !== undefined) db.mixer.faderMinDb = Number(faderMinDb);
  if (faderMaxDb !== undefined) db.mixer.faderMaxDb = Number(faderMaxDb);
  store.save(db);
  startMixerClient();
  res.json({ ok: true, mixer: db.mixer });
});

app.post("/api/admin/mixer/reconnect", requireAdmin, (req, res) => {
  startMixerClient();
  res.json({ ok: true, mixer: db.mixer });
});

// Determine which aux mixes are available/shown to normal users
app.post("/api/admin/mixes/:id", requireAdmin, (req, res) => {
  const mix = findMix(req.params.id);
  if (!mix) return res.status(404).json({ error: "Mix not found" });
  const { name, visible, channelIds } = req.body || {};
  if (name !== undefined) mix.name = name;
  if (visible !== undefined) mix.visible = !!visible;
  if (Array.isArray(channelIds)) mix.channelIds = channelIds;
  store.save(db);
  if (Array.isArray(channelIds)) {
    // Channel-to-aux assignment changed: push the new mix config straight to
    // the clients actually viewing this mix, immediately after the write
    // succeeds — no page reload on their side.
    broadcastToMix(mixConfigMessage(mix), mix.id);
  } else {
    // Name/visibility only — keep the existing global refresh.
    broadcast({ type: "mixesChanged" });
  }
  res.json({ ok: true, mix });
});

app.post("/api/admin/channels/count", requireAdmin, (req, res) => {
  const { count } = req.body || {};
  const n = Math.max(1, Math.min(40, Number(count) || 16)); // TF consoles expose at most 40 input channels
  const current = db.channels.length;
  if (n > current) {
    for (let i = current; i < n; i++) {
      const ch = { id: `ch${i + 1}`, index: i, name: `Channel ${i + 1}` };
      db.channels.push(ch);
      db.mixes.forEach((m) => m.channelIds.push(ch.id));
    }
  } else if (n < current) {
    const removed = db.channels.slice(n).map((c) => c.id);
    db.channels = db.channels.slice(0, n);
    db.mixes.forEach((m) => (m.channelIds = m.channelIds.filter((id) => !removed.includes(id))));
  }
  store.save(db);
  // Channel count changed, so every mix's channel list may have gained/lost
  // entries — push each mix's updated config to its own viewers in real time.
  db.mixes.forEach((m) => broadcastToMix(mixConfigMessage(m), m.id));
  res.json({ ok: true, channels: db.channels });
});

app.post("/api/admin/channels/:id", requireAdmin, (req, res) => {
  const ch = findChannel(req.params.id);
  if (!ch) return res.status(404).json({ error: "Channel not found" });
  const { name } = req.body || {};
  if (name !== undefined) ch.name = name;
  store.save(db);
  broadcast({ type: "mixesChanged" });
  res.json({ ok: true, channel: ch });
});

// Pull channel and aux (mix) names straight off the console, overwriting the
// locally-typed names. Skips anything the mixer doesn't answer for (e.g. a
// channel/mix that isn't patched) so partial consoles don't error out.
app.post("/api/admin/sync-names", requireAdmin, async (req, res) => {
  if (!mixerStatus.connected) {
    return res.status(409).json({ error: "Not connected to the console right now" });
  }
  const updated = { channels: 0, mixes: 0, returns: 0, dca: 0, skipped: 0 };
  for (const ch of db.channels) {
    try {
      const name = await rcp.getChannelName("in", ch.index);
      if (name && name.trim()) {
        ch.name = name.trim();
        updated.channels++;
      } else {
        updated.skipped++;
      }
    } catch (e) {
      updated.skipped++;
    }
  }
  for (const ret of db.returns) {
    try {
      const name = await rcp.getChannelName("fx", ret.index);
      if (name && name.trim()) {
        ret.name = name.trim();
        updated.returns++;
      } else {
        updated.skipped++;
      }
    } catch (e) {
      updated.skipped++;
    }
  }
  for (const d of db.dca) {
    try {
      const name = await rcp.getDcaName(d.index);
      if (name && name.trim()) {
        d.name = name.trim();
        updated.dca++;
      } else {
        updated.skipped++;
      }
    } catch (e) {
      updated.skipped++;
    }
  }
  for (const mix of db.mixes) {
    try {
      const name = await rcp.getMixName(mix.index);
      if (name && name.trim()) {
        mix.name = name.trim();
        updated.mixes++;
      } else {
        updated.skipped++;
      }
    } catch (e) {
      updated.skipped++;
    }
  }
  store.save(db);
  broadcast({ type: "mixesChanged" });
  res.json({ ok: true, updated, mode: db.mixer.mode, channels: db.channels, returns: db.returns, dca: db.dca, mixes: db.mixes });
});

// "Ability to Remove connection based on name input"
app.post("/api/admin/sessions/remove", requireAdmin, (req, res) => {
  const { name } = req.body || {};
  if (!name) return res.status(400).json({ error: "Name is required" });
  const key = name.trim().toLowerCase();
  const session = db.sessions[key];
  if (!session) return res.status(404).json({ error: "No active user with that name" });
  delete db.sessions[key];
  store.save(db);
  broadcast({ type: "sessionRemoved", name: session.name });
  res.json({ ok: true });
});

// raw console for calibrating against real hardware (see rcpClient.js notes)
app.post("/api/admin/raw", requireAdmin, async (req, res) => {
  const { command } = req.body || {};
  if (!command) return res.status(400).json({ error: "Command is required" });
  try {
    const reply = await rcp.raw(command);
    res.json({ ok: true, reply });
  } catch (e) {
    res.status(502).json({ error: e.message });
  }
});

// =========================================================================

const server = app.listen(PORT, "0.0.0.0", () => {
  console.log(`Monitor mix app listening on http://localhost:${PORT}`);
  startMixerClient();
});

wss = new WebSocketServer({ server, path: "/ws" });
wss.on("connection", (ws) => {
  ws.send(JSON.stringify({ type: "mixerStatus", status: mixerStatus }));
  ws.on("message", (raw) => {
    let msg = null;
    try { msg = JSON.parse(raw); } catch (e) { return; }
    if (msg && msg.type === "subscribe" && typeof msg.mixId === "string") {
      // Tag this socket with the aux mix its user is viewing so
      // mixConfigUpdated broadcasts can be filtered to the right clients.
      // Reuses the existing anonymous WS model — no new auth/session checks.
      ws.mixId = msg.mixId;
      // Push the current assignment immediately: covers reconnects where the
      // client may have missed a change while the socket was down.
      const mix = findMix(msg.mixId);
      if (mix) ws.send(JSON.stringify(mixConfigMessage(mix)));
    }
  });
});

// ---- graceful shutdown ----
function shutdown(signal) {
  console.log(`Received ${signal}, shutting down...`);
  if (rcp) rcp.stop();
  if (wss) wss.close();
  server.close(() => {
    console.log("Server closed.");
    process.exit(0);
  });
  // ponytail: force exit if graceful close hangs (stuck sockets, slow clients)
  setTimeout(() => { console.error("Forced shutdown after timeout"); process.exit(1); }, 5000);
}

process.on("SIGTERM", () => shutdown("SIGTERM"));
process.on("SIGINT", () => shutdown("SIGINT"));

// ---- crash protection ----
process.on("uncaughtException", (err) => {
  console.error("Uncaught exception:", err.stack || err.message);
  process.exit(1);
});

process.on("unhandledRejection", (reason) => {
  console.error("Unhandled rejection:", reason);
  process.exit(1);
});
