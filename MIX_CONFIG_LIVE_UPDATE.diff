+// Send a message only to sockets that have subscribed to a specific aux mix.
+// Kept separate from broadcast() so the existing global messages (mixerStatus,
+// notify, mixesChanged, sessionsChanged, ...) keep their current behavior.
+// Sockets opt in by sending { type: "subscribe", mixId } after opening /ws.
+function broadcastToMix(msg, mixId) {
+  if (!wss) return;
+  const data = JSON.stringify(msg);
+  wss.clients.forEach((client) => {
+    if (client.readyState === 1 && client.mixId === mixId) client.send(data);
+  });
+}
 
